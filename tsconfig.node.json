{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["electron/main/**/*.ts", "electron/preload/**/*.ts", "electron/content/messages.ts", "electron.vite.config.ts"]
}
